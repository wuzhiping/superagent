{
  "name": "dsh-superagent",
  "author": "DeepSeek Harness Team <team@dsh.dev>",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "超级智能体 / SuperAgent: a proactive DSH bundle for Kaneo boards, Gitea repositories and ntfy topics — it evaluates requests under a Policy, turns authorized ones into Tickets, executes each in its own DSH Session and replies in the original conversation.",
  "type": "module",
  "bin": {
    "dsh-superagent": "./bin/install.mjs"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./github-watch": "./lib/github-watch.js",
    "./feishu-watch": "./lib/feishu-watch.js",
    "./kaneo-watch": "./lib/kaneo-watch.js",
    "./gitea-watch": "./lib/gitea-watch.js",
    "./ntfy-watch": "./lib/ntfy-watch.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "bin",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "INSTALL.md",
    "prompts",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "pnpm --dir dev run build",
    "typecheck": "pnpm --dir dev run typecheck",
    "test": "pnpm --dir dev run test",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3"
  }
}
